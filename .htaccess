Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(env|git)" - [F,L]
</IfModule>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sqlite|sqlite3|db)$">
    Require all denied
</FilesMatch>

<FilesMatch "^config\.php$">
    Require all denied
</FilesMatch>
